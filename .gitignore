# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
env/
.env

# ── Runtime-generated data (server writes these — never commit) ──
# ChromaDB vector database
vectordb/*.sqlite3
vectordb/*/data_level0.bin
vectordb/*/header.bin
vectordb/*/index_metadata.pickle
vectordb/*/length.bin
vectordb/*/link_lists.bin

# Ingestion manifest and API call log (server updates these live)
output/ingestion_manifest.json
output/.last_api_call

# ── Papers folder ─────────────────────────────────────────────────
# Never commit uploaded PDFs to the repository
papers/*.pdf
papers/**/*.pdf

# ── System and editor files ───────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.egg-info/

# ── Keep empty placeholder files ─────────────────────────────────
!vectordb/.gitkeep
!output/.gitkeep
!papers/.gitkeep
".env" 
