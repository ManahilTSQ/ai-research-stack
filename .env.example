# =============================================================================
# AI Research Stack — Example Environment Configuration
# =============================================================================
# Copy this file to .env and replace the placeholder values with your own.
# =============================================================================

# Semantic Scholar API Key (Optional — increases rate limits significantly)
SEMANTIC_SCHOLAR_API_KEY=api-key-here

# Unpaywall API Email (Required — any valid email)
UNPAYWALL_EMAIL=your@email.com

# Ollama LLM Server (default: local Ollama on standard port)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:70b
OLLAMA_TIMEOUT=300

# Storage paths (relative to project root)
PDF_DOWNLOAD_DIR=papers
VECTOR_DB_DIR=vectordb
