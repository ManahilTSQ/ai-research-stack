# =============================================================================
# AI Research Stack — Example Environment Configuration
# =============================================================================
# Copy this file to .env and replace the placeholder values with your own.
# =============================================================================

# Semantic Scholar API Key (Optional — increases rate limits significantly)
SEMANTIC_SCHOLAR_API_KEY=api-key-here

# Unpaywall API Email (Required — any valid email)
UNPAYWALL_EMAIL=your@email.com

# Ollama LLM Server (default: local Ollama on standard port)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:70b
OLLAMA_TIMEOUT=600

# HTTP Basic Auth for web UI and API (change in production)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASS=Aitawfiq26!!!

# RAG: max ChromaDB cosine distance for a chunk to count as relevant (lower = stricter)
RAG_MAX_DISTANCE=0.85

# RAG: require at least one significant query term to appear in retrieved chunks
RAG_REQUIRE_QUERY_TERM_MATCH=true

# Strict RAG: entity resolution, scoped retrieval, answer verification (recommended)
RAG_STRICT_MODE=true

# Auto-delete citation CSV reports older than N days (0 = keep forever)
REPORT_RETENTION_DAYS=0

# Storage paths (relative to project root)
PDF_DOWNLOAD_DIR=papers
VECTOR_DB_DIR=vectordb
